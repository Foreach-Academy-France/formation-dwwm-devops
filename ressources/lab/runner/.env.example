# Copier ce fichier en « .env » (cp .env.example .env) puis remplir les valeurs.
# Le fichier .env n'est JAMAIS commité (il contient un jeton).

# Adresse de VOTRE dépôt (pas celui du formateur)
REPO_URL=https://github.com/VOTRE-PSEUDO/taskflow

# Jeton d'enregistrement : dépôt > Settings > Actions > Runners > New self-hosted runner
# Valable ~1 heure : à copier juste avant de démarrer.
RUNNER_TOKEN=

RUNNER_NAME=lab-runner
LABELS=self-hosted,lab

# Dossier « serveur » créé à l'étape 4a : CHEMIN ABSOLU, sans ~ ni $HOME.
#   Linux  : /home/<vous>/taskflow-prod
#   macOS  : /Users/<vous>/taskflow-prod   (dossier à partager dans Docker Desktop > Settings > Resources > File sharing si besoin)
#   WSL2   : /home/<vous>/taskflow-prod    (travaillez DANS WSL, pas sous /mnt/c ; Docker Desktop > Settings > Resources > WSL integration activée)
DEPLOY_DIR=/home/VOUS/taskflow-prod
